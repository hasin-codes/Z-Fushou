  "private": true,
  "main": "main.js",
  "scripts": {
    "dev": "next dev",
    "electron": "electron .",
    "electron:dev": "concurrently -k \"npm run dev\" \"wait-on http://localhost:3000 && set ELECTRON_RENDERER_URL=http://localhost:3000&& electron .\"",
    "build": "next build",
    "postbuild": "node scripts/prepare-standalone.mjs",
    "dist": "node scripts/convert-logo.mjs && npm run build && electron-builder",
    "start": "node scripts/convert-logo.mjs && npm run build && electron .",
    "start:web": "node .next/standalone/server.js",
    "lint": "eslint"
  },
  "dependencies": {
