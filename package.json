    "electron-updater": "^6.8.3",
    "keytar": "^7.9.0",
    "lucide-react": "^1.7.0",
    "next": "^16.2.6",
    "nuqs": "^2.8.9",
    "radix-ui": "^1.4.3",
    "react": "19.2.4",
    "react-day-picker": "^9.14.0",
    "react-dom": "19.2.4",
    "shadcn": "^4.1.1",
    "tailwind-merge": "^3.5.0",
    "three": "^0.167.1",
    "tw-animate-css": "^1.4.0",
